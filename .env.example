APP_NAME=Gonic Library Manager
APP_HOST=0.0.0.0
APP_PORT=8080

# Mount this to the same directory gonic serves.
MUSIC_LIBRARY_PATH=/music

# Stores the SQLite index database.
DATA_DIR=/data

# Comma-separated audio extensions scanned into the index.
LIBRARY_EXTENSIONS=.mp3,.flac,.ogg,.opus,.m4a,.aac,.wav
